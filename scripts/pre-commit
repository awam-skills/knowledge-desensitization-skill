#!/bin/sh
# ============================================================
# pre-commit 护栏：阻止明文凭据进入版本库
# 安装：cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# 设计要点
# 1) 只输出「类型 + 文件:行号」，绝不输出命中内容 —— 避免钩子日志成为二次泄露渠道。
# 2) 用 git grep --cached 单进程扫索引（v1 逐文件 grep 会起 3000+ 进程，跑满超时）。
# 3) 正则必须与 config/rules.json 同源同强度。v1 缺少左边界，把普通英文词（task-/disk-）
#    误报为密钥；v2 起统一用 (^|[^A-Za-z0-9]) 左边界。POSIX ERE 无 lookbehind，用 ^ 或取反字符类代替。
# 4) 定位是兜底拦截，不替代 scripts/sanitize.py 的正式脱敏。
# ============================================================

found=0

check() {
    # $1 = 类型名   $2 = ERE 正则
    hits=$(git grep --cached -n -I -E -e "$2" -- . \
             ':(exclude).km' ':(exclude)vault' ':(exclude)reports' ':(exclude).tmp' \
             2>/dev/null | sed 's/:[^:]*$//' | tr '\n' '|')
    if [ -n "$hits" ]; then
        echo "  [$1] $hits" >&2
        found=1
    fi
}

check "AWS AccessKey"    '(^|[^A-Za-z0-9_])AKIA[0-9A-Z]{16}'
check "厂商标识型密钥"      '(^|[^A-Za-z0-9])[a-z]{1,8}[0-9]{1,4}sk-[A-Za-z0-9_-]{8,}'
check "LLM API Key"      '(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}'
check "GitHub Token"     '(^|[^A-Za-z0-9_])gh[pousr]_[A-Za-z0-9]{20,}'
check "Slack Token"      '(^|[^A-Za-z0-9_])xox[baprs]-[A-Za-z0-9-]{10,}'
check "私钥块"           '-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----'
check "JWT"              '(^|[^A-Za-z0-9_])eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{4,}'
check "带密码连接串"       '://[^/[:space:]:@]+:[^/[:space:]:@]{4,}@'

if [ "$found" = "1" ]; then
    {
        echo ""
        echo "✖ pre-commit 拦截：暂存区检测到疑似明文凭据（内容已隐藏）"
        echo ""
        echo "处理方式："
        echo "  1) 正式脱敏  : python scripts/pipeline.py --id <源id> --apply"
        echo "  2) 凭据入库  : pwsh -File scripts/bitwarden-import.ps1 -DataRoot <数据根>/.km/<源id>"
        echo "  3) 确认误报  : git commit --no-verify，并回头补 <秘密材料目录>/config/rules.json 规则"
        echo "  4) 若误把运行数据（.km / vault / reports）纳入暂存，请先从索引移除"
        echo ""
    } >&2
    exit 1
fi

exit 0